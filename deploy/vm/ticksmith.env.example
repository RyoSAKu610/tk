# Ticksmith on a Cloud VM — runtime settings for tools/serve.mjs.
# setup.sh --install-service copies this to /etc/ticksmith/ticksmith.env (only if
# that file does not exist yet). No secrets are needed: Hyperliquid's info API is public.

# Listen only on loopback and put a TLS reverse proxy (Caddy / nginx) in front.
# Use 0.0.0.0 only if you expose the port directly (then set TRUST_PROXY=0).
HOST=127.0.0.1
PORT=4173

# 1 = trust X-Forwarded-For from the reverse proxy on this host (needed for the
#     per-client rate limit to see real client IPs). The proxy must SET the header
#     to the client address, not append to a client-supplied one.
# 0 = use the TCP peer address (when clients connect to this port directly).
TRUST_PROXY=1

# Upstream (official Hyperliquid info endpoint). https only.
HL_INFO_URL=https://api.hyperliquid.xyz/info
HL_TIMEOUT_MS=8000
HL_MAX_RETRIES=2
HL_RETRY_BASE_MS=250
# Hyperliquid allows 1200 weight/min per IP. A VM has one egress IP, so everything
# on this VM that calls Hyperliquid shares that limit; keep headroom.
HL_WEIGHT_BUDGET_PER_MIN=900
HL_WEIGHT_MAX_WAIT_MS=3000

# Per-client token bucket.
CLIENT_RATE_PER_SEC=5
CLIENT_BURST=20

CACHE_MAX_ENTRIES=500
CORS_ALLOW_ORIGIN=*
LOG_LEVEL=info
